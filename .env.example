# --- Edge / Selenium -------------------------------------------------
# Path to msedgedriver.exe. A directory or glob is also accepted.
# `just update-driver` downloads the matching driver and updates this line.
EDGE_DRIVER_PATH=./driver/stable/msedgedriver.exe
SEARCH_URL=https://www.bing.com

# Live Edge user-data directory (read-only source for the profile copy).
# Optional: leave empty to use profiles straight from SELENIUM_USER_DATA_DIR.
ORIGINAL_USER_DATA_DIR=C:\Users\username\AppData\Local\Microsoft\Edge\User Data

# Separate directory used by Selenium. It must NOT be the live Edge folder
# when ORIGINAL_USER_DATA_DIR is set.
SELENIUM_USER_DATA_DIR=D:\SeleniumProfiles\EdgeUserData

# Comma-separated Edge profile directory names.
PROFILES=Profile 1

SEARCHES_PER_PROFILE=35

# --- Behaviour -------------------------------------------------------
# Close all running Edge windows before a session starts.
CLOSE_EXISTING_EDGE=true

# Maximum seconds to wait for a page to load.
PAGE_LOAD_TIMEOUT=30

# Edge window: maximized | minimized | offscreen
#   minimized = minimized to the taskbar (a new tab can bring it back)
#   offscreen = opened outside the screen, never in the way (recommended)
EDGE_WINDOW_MODE=maximized

# Stop a profile after this many failed searches in a row.
MAX_CONSECUTIVE_FAILURES=3

# --- Bing Rewards ----------------------------------------------------
# Rewards runs in a second tab next to the searches. Set false to skip.
REWARDS_ENABLED=true
REWARDS_URL=https://rewards.bing.com
# REWARDS_EARN_URL=https://rewards.bing.com/earn

# Check for points that are ready to claim every N seconds.
REWARDS_CLAIM_INTERVAL=5

# Maximum seconds to wait for a rewards page or task tab to load.
REWARDS_TASK_TIMEOUT=25

# Folder with free photos for the image-search task.
REWARDS_PHOTO_DIR=C:\Users\username\Pictures

# 0 = keep trying different photos until the task is checked.
REWARDS_PHOTO_MAX_ATTEMPTS=0

# Ignore tiny files such as icons and thumbnails.
REWARDS_PHOTO_MIN_BYTES=4096

# --- Optional non-interactive schedule -------------------------------
# CLI arguments and the `just run-at` / `just run-daily` recipes take
# priority over these values. Uncomment only one mode.
#
# SCHEDULE_MODE=once
# SCHEDULE_AT=2026-11-12 13:00
#
# SCHEDULE_MODE=daily
# SCHEDULE_DAILY_TIME=00:01
#
# SCHEDULE_MODE=now
