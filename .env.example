# --- Edge / Selenium -------------------------------------------------
# Path to msedgedriver.exe. A directory or glob is also accepted.
# `just update-driver` downloads the matching driver and updates this line.
EDGE_DRIVER_PATH=./driver/stable/msedgedriver.exe
SEARCH_URL=https://www.bing.com

# Live Edge user-data directory (read-only source for the profile copy).
# Optional: leave empty to use profiles straight from SELENIUM_USER_DATA_DIR.
ORIGINAL_USER_DATA_DIR=C:\Users\username\AppData\Local\Microsoft\Edge\User Data

# Separate directory used by Selenium. It must NOT be the live Edge folder
# when ORIGINAL_USER_DATA_DIR is set.
SELENIUM_USER_DATA_DIR=D:\SeleniumProfiles\EdgeUserData

# Comma-separated Edge profile directory names.
PROFILES=Profile 1

SEARCHES_PER_PROFILE=35

# --- Behaviour -------------------------------------------------------
# Close all running Edge windows before a session starts.
CLOSE_EXISTING_EDGE=true

# Maximum seconds to wait for a page to load.
PAGE_LOAD_TIMEOUT=30

# Edge window: maximized | minimized | offscreen
#   minimized = minimized to the taskbar (a new tab can bring it back)
#   offscreen = opened outside the screen, never in the way (recommended)
EDGE_WINDOW_MODE=maximized

# Stop a profile after this many failed searches in a row.
MAX_CONSECUTIVE_FAILURES=3

# --- Bing Rewards ----------------------------------------------------
# Rewards runs in a second tab next to the searches. Set false to skip.
REWARDS_ENABLED=true
REWARDS_URL=https://rewards.bing.com
# REWARDS_EARN_URL=https://rewards.bing.com/earn

# Check for points that are ready to claim every N seconds.
REWARDS_CLAIM_INTERVAL=5

# Maximum seconds to wait for a rewards page or task tab to load.
REWARDS_TASK_TIMEOUT=25

# Folder with free photos for the image-search task.
REWARDS_PHOTO_DIR=C:\Users\username\Pictures

# 0 = keep trying different photos until the task is checked.
REWARDS_PHOTO_MAX_ATTEMPTS=0

# Ignore tiny files such as icons and thumbnails.
REWARDS_PHOTO_MIN_BYTES=4096

# PC search: searches are cut to what the daily cap (90 points) still
# needs, at this many points per search, then topped up if short.
REWARDS_POINTS_PER_SEARCH=3
REWARDS_SEARCH_TOPUP_ROUNDS=2

# "Set as wallpaper" (+20) task on /earn.
REWARDS_WALLPAPER_TIMEOUT=120
REWARDS_WALLPAPER_ATTEMPTS=3

# --- Mobile pass -----------------------------------------------------
# off         = web only (the mobile code never runs)
# replace     = run the whole session as mobile
# second_pass = web first, then the phone pass (needs MOBILE_BACKEND=appium)
MOBILE_RUN_MODE=second_pass

# web    = Selenium + DevTools emulation.
# appium = also read news in the Bing app on a real phone (Read to Earn),
#          once at the end of the session. Appium starts by itself.
MOBILE_BACKEND=web

# Preset in src/mobile/devices.ts: pixel_7, pixel_8, galaxy_s23
MOBILE_DEVICE=pixel_7

# 0 = same as SEARCHES_PER_PROFILE.
MOBILE_SEARCHES_PER_PROFILE=0

# Locale used for the mobile session and the MSN feed.
MOBILE_LOCALE=en-US

# Edge window for the mobile pass: maximized | minimized | offscreen
MOBILE_WINDOW_MODE=offscreen

# Skip the mobile pass when the page probe does not see a phone.
MOBILE_PROBE_STRICT=true

# MSN news reading inside the mobile pass.
MOBILE_NEWS_ENABLED=true
MOBILE_NEWS_MAX=3
MOBILE_NEWS_DWELL_MIN=3
MOBILE_NEWS_DWELL_MAX=3
MOBILE_NEWS_SCROLL=1
MOBILE_NEWS_FEED_URL=https://www.msn.com/en-us/news

# --- Bing app through Appium -----------------------------------------
# Read to Earn is credited only inside the Bing/MSN app, so this path uses
# a real Android phone (USB debugging on, unlocked, signed in to Bing).
MOBILE_APPIUM_SERVER=http://127.0.0.1:4723

# Serial from `adb devices`. Empty = the only attached device.
MOBILE_APPIUM_UDID=

# Empty title is fine; Appium reads it from the phone.
MOBILE_APPIUM_DEVICE_NAME=Android
MOBILE_APPIUM_PLATFORM_VERSION=

# Bing app. The MSN app uses com.microsoft.news.
MOBILE_APPIUM_APP_PACKAGE=com.microsoft.bing
MOBILE_APPIUM_APP_ACTIVITY=

# Keep the signed-in account and app data between runs.
MOBILE_APPIUM_NO_RESET=true

# Server command timeout and screen wait, in seconds.
MOBILE_APPIUM_TIMEOUT=30
MOBILE_APPIUM_WAIT=25

# Read to Earn in the Bing app.
MOBILE_APP_NEWS_ENABLED=true
MOBILE_APP_NEWS_MAX=10
MOBILE_APP_DWELL_MIN=15
MOBILE_APP_DWELL_MAX=30
# Feed swipes without a new card before giving up.
MOBILE_APP_MAX_SWIPES=12

# Accounts in the Bing app (profile button, top-left → account → Accounts).
# Comma-separated emails, run in this order. Empty = every account in the
# app, starting with the active one. Each reads MOBILE_APP_NEWS_MAX articles.
MOBILE_APP_ACCOUNTS=
# Switch back to the account that was active before the run.
MOBILE_APP_RESTORE_ACCOUNT=true
# Before reading, per account: Rewards page (profile → Total points) →
# daily check-in, then open every unfinished "More activities" card.
MOBILE_APP_CHECKIN=true
MOBILE_APP_ACTIVITIES=true
# Read until Read to earn shows 30/30: rounds of up to MOBILE_APP_NEWS_MAX
# articles, re-checking the counter after each round.
MOBILE_APP_READ_ROUNDS=3
# Close all tabs in the Bing app after each account (open tabs slow it down).
MOBILE_APP_CLOSE_TABS=true
# Accounts that fail (slow phone, Bing lag) are run again after the last
# account, on a restarted app. Number of extra rounds; 0 = off.
MOBILE_APP_RETRY=1
# Skip reading when Daily points already show the cap (e.g. 120/120).
MOBILE_APP_SKIP_FULL=true
# Wireless adb (no cable). Set by `just mobile wifi usb` / `pair`; every
# mobile run reconnects to it when the phone is not attached.
MOBILE_ADB_WIFI=
MOBILE_ADB_WIFI_AUTO=true
# `just mobile run` starts a local Appium server when none is running.
MOBILE_APPIUM_AUTOSTART=true

# --- Desktop: Microsoft Rewards app for Windows (`just desktop`) -----
# One saved sign-in per account lives here; keep it outside the repo and
# any synced folder. Default: %LOCALAPPDATA%\edge-ts\desktop-profiles
# DESKTOP_PROFILES_DIR=

# offscreen (default): the app window is kept outside the monitors during
# `just desktop run`; visible: leave it where it opens.
DESKTOP_WINDOW_MODE=offscreen

# --- Optional non-interactive schedule -------------------------------
# CLI arguments and the `just run-at` / `just run-daily` recipes take
# priority over these values. Uncomment only one mode.
#
# SCHEDULE_MODE=once
# SCHEDULE_AT=2026-11-12 13:00
#
# SCHEDULE_MODE=daily
# SCHEDULE_DAILY_TIME=00:01
#
# SCHEDULE_MODE=now
